{
  "schemaVersion": "uplb-architecture-kit-v0.1",
  "kitVersion": "0.1.0",
  "units": "meters",
  "status": "prototype",
  "principles": [
    "Reusable modules over one-off meshes",
    "Stable IDs and deterministic dimensions",
    "UPLB-specific derivatives replace generic placeholders over time",
    "Hero buildings may override every default",
    "Texture/material reuse is preferred for Roblox batching and memory"
  ],
  "families": [
    {
      "id": "uplb-historic-prewar",
      "description": "Historic/prewar landmark buildings such as Baker Hall; bespoke proportions and ornament are expected.",
      "defaultFloorHeightM": 4.0,
      "defaultBayWidthM": 3.0,
      "allowedRoofFamilies": [
        "roof:gable-metal",
        "roof:hip-metal"
      ]
    },
    {
      "id": "uplb-concrete-academic-midcentury",
      "description": "Mid-century reinforced-concrete academic buildings with repetitive bays, deep shade, and operable windows.",
      "defaultFloorHeightM": 3.7,
      "defaultBayWidthM": 3.2,
      "allowedRoofFamilies": [
        "roof:flat-parapet",
        "roof:low-slope-metal"
      ]
    },
    {
      "id": "uplb-concrete-academic-late20c",
      "description": "Later concrete academic/admin buildings with repeated grids and covered circulation.",
      "defaultFloorHeightM": 3.5,
      "defaultBayWidthM": 3.0,
      "allowedRoofFamilies": [
        "roof:flat-parapet",
        "roof:low-slope-metal"
      ]
    },
    {
      "id": "uplb-concrete-service-1970s",
      "description": "Service/health/support buildings emphasizing simple reinforced-concrete massing.",
      "defaultFloorHeightM": 3.5,
      "defaultBayWidthM": 3.0,
      "allowedRoofFamilies": [
        "roof:flat-parapet",
        "roof:hip-metal"
      ]
    },
    {
      "id": "uplb-modern-glass-concrete",
      "description": "Contemporary glass/concrete buildings.",
      "defaultFloorHeightM": 3.8,
      "defaultBayWidthM": 3.2,
      "allowedRoofFamilies": [
        "roof:flat-parapet"
      ]
    },
    {
      "id": "uplb-auditorium",
      "description": "Auditoria/large assembly halls; geometry is typically bespoke but shares campus materials and circulation modules.",
      "defaultFloorHeightM": 4.5,
      "defaultBayWidthM": 4.0,
      "allowedRoofFamilies": [
        "roof:low-slope-metal",
        "roof:flat-parapet"
      ]
    },
    {
      "id": "uplb-athletic",
      "description": "Athletic/recreation buildings with long spans and bespoke roof structures.",
      "defaultFloorHeightM": 4.0,
      "defaultBayWidthM": 4.0,
      "allowedRoofFamilies": [
        "roof:gable-metal",
        "roof:low-slope-metal"
      ]
    },
    {
      "id": "uplb-open-space",
      "description": "Landscape/open-space landmark family; not a building facade generator.",
      "defaultFloorHeightM": 1.0,
      "defaultBayWidthM": 5.0,
      "allowedRoofFamilies": []
    },
    {
      "id": "uplb-landmark-sculpture",
      "description": "Monuments/sculpture assemblies; always custom/recovered rather than procedural building generation.",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPLB Production Asset Manifest v0.2",
  "type": "object",
  "required": ["schemaVersion", "assetId", "featureId", "sourceFeatureId", "productionStage", "stableMeshNames", "lods", "collision", "exchange", "qa", "inputs"],
  "properties": {
    "schemaVersion": {"const": "uplb-production-asset-manifest-v0.2"},
    "assetId": {"type": "string", "minLength": 1},
    "featureId": {"type": "string", "pattern": "^uplb:"},
    "sourceFeatureId": {"type": "string", "pattern": "^(candidate:|uplb:)"},
    "productionStage": {"enum": ["prototype", "visual-review", "production-ready"]},
    "stableMeshNames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "lods": {"type": "object"},
    "collision": {"type": "object"},
    "exchange": {"type": "object"},
    "qa": {"type": "object"},
    "inputs": {"type": "object"}
  },
  "additionalProperties": true
}

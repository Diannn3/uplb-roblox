{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPLB Building Production Specification",
  "type": "object",
  "required": ["featureId", "referenceIds", "productionTier", "verificationStatus"],
  "properties": {
    "featureId": {"type": "string", "pattern": "^uplb:building:"},
    "referenceIds": {"type": "array", "items": {"type": "string"}},
    "productionTier": {"enum": ["greybox", "background", "standard-exterior", "hero-exterior", "detailed-interior"]},
    "dimensions": {"type": "object"},
    "architecturalFamily": {"type": ["string", "null"]},
    "modules": {"type": "array"},
    "materials": {"type": "array"},
    "budgets": {"type": "object"},
    "lod": {"type": "object"},
    "collision": {"type": "object"},
    "verificationStatus": {"type": "string"},
    "openQuestions": {"type": "array", "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}

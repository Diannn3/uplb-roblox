{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPLB Production Asset Binding Registry",
  "type": "object",
  "required": ["schemaVersion", "waveId", "sourceGit", "records", "registryHash"],
  "properties": {
    "schemaVersion": {"const": "uplb-production-asset-binding-registry-v0.1"},
    "waveId": {"type": "string", "minLength": 1},
    "sourceGit": {"type": "object"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["featureId", "sourceFeatureId", "assetId", "productionStage", "assetManifestPath", "assetManifestSha256", "placementBindingPath", "placementBindingHash", "scenePlacementAuthority", "visualReviewGate"],
        "properties": {
          "featureId": {"type": "string", "pattern": "^uplb:"},
          "sourceFeatureId": {"type": "string", "pattern": "^(candidate:|uplb:)"},
          "assetId": {"type": "string", "minLength": 1},
          "productionStage": {"enum": ["prototype", "visual-review", "production-ready"]},
          "assetManifestPath": {"type": "string", "minLength": 1},
          "assetManifestSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "placementBindingPath": {"type": "string", "minLength": 1},
          "placementBindingHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "scenePlacementAuthority": {"const": "canonical-scene"},
          "visualReviewGate": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "registryHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

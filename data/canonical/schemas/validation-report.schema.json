{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPLB Validation Report",
  "type": "object",
  "required": ["id", "inputRevisions", "checks", "decision"],
  "properties": {
    "id": {"type": "string", "pattern": "^validation:"},
    "inputRevisions": {"type": "object"},
    "checks": {"type": "array", "items": {"type": "object", "required": ["name", "status"], "properties": {"name": {"type": "string"}, "status": {"enum": ["pass", "fail", "warning", "not-run"]}, "details": {"type": "string"}}, "additionalProperties": false}},
    "measurements": {"type": "object"},
    "discrepancies": {"type": "array"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "decision": {"enum": ["pass", "fail", "conditional"]},
    "engineeringGate": {"enum": ["pass", "fail"]},
    "canonicalIdentityGate": {"enum": ["pass", "fail"]},
    "geometryGate": {"enum": ["pass", "fail"]},
    "reproducibilityGate": {"enum": ["pass", "fail"]},
    "humanReviewGate": {"enum": ["pending", "pass"]},
    "demRightsGate": {"enum": ["pending", "pass", "fail"]},
    "overtureComparisonGate": {"enum": ["pass", "deferred", "blocked"]},
    "worldgenReady": {"type": "boolean"},
    "campusWideProductionReady": {"type": "boolean"}
  },
  "additionalProperties": false
}

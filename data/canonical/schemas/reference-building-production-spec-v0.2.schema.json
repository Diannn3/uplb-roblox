{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPLB Evidence-Aware Reference Building Production Spec v0.2",
  "type": "object",
  "required": [
    "schemaVersion", "sourceFeatureId", "proposedFeatureId", "name", "productionTier",
    "productionStage", "identityStatus", "architecturalFamily", "referenceIds", "featureSnapshot",
    "referenceProfile", "height", "orientation", "facade", "roof", "materials", "artifactContract",
    "accuracyClaims", "openQuestions"
  ],
  "properties": {
    "schemaVersion": {"const": "uplb-reference-building-production-spec-v0.2"},
    "sourceFeatureId": {"type": "string", "pattern": "^(candidate:|uplb:)"},
    "proposedFeatureId": {"type": "string", "pattern": "^uplb:"},
    "name": {"type": "string", "minLength": 1},
    "productionTier": {"enum": ["hero-exterior", "standard-exterior", "context-exterior"]},
    "productionStage": {"enum": ["prototype", "visual-review", "production-ready"]},
    "identityStatus": {"enum": ["canonical", "reviewed-candidate", "proposed-candidate"]},
    "architecturalFamily": {"type": "string", "minLength": 1},
    "referenceIds": {"type": "array", "items": {"type": "string"}},
    "featureSnapshot": {"type": "string", "minLength": 1},
    "referenceProfile": {"type": "string", "minLength": 1},
    "height": {
      "type": "object",
      "required": ["meters", "method", "confidence"],
      "properties": {
        "meters": {"type": "number", "exclusiveMinimum": 0},
        "method": {"type": "string"},
        "confidence": {"type": "string"}
      }
    },
    "orientation": {
      "type": "object",
      "required": ["policy", "confidence", "reviewStatus", "evidenceIds"],
      "properties": {
        "policy": {"enum": ["unknown", "longest-edge-proxy", "reviewed-source-edge", "reviewed-azimuth", "entrance-anchor", "legacy-model-derived", "field-measured"]},
        "confidence": {"enum": ["unknown", "proxy", "low", "medium-low", "medium", "medium-high", "high", "field-measured"]},
        "reviewStatus": {"enum": ["unreviewed", "reviewed"]},
        "edgeIndex": {"type": "integer", "minimum": 0},
        "frontAzimuthDegrees": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
        "entranceAnchorLocalMeters": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "evidenceIds": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "facade": {"type": "object"},
    "roof": {"type": "object"},
    "materials": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifactContract": {
      "type": "object",
      "required": ["assetId", "stableMeshNames", "aggregateLodBudgets", "perMeshPartTriangleLimit", "maxMeshParts"],
      "properties": {
        "assetId": {"type": "string", "minLength": 1},
        "stableMeshNames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}},
        "aggregateLodBudgets": {
          "type": "object",
          "required": ["lod0", "lod1", "lod2", "lod3"],
          "properties": {
            "lod0": {"type": "integer", "minimum": 0},
            "lod1": {"type": "integer", "minimum": 0},
            "lod2": {"type": "integer", "minimum": 0},
            "lod3": {"type": "integer", "minimum": 0}
          }
        },
        "perMeshPartTriangleLimit": {"type": "integer", "minimum": 1, "maximum": 20000},
        "maxMeshParts": {"type": "integer", "minimum": 1},
        "preferredExchangeFormat": {"enum": ["GLB", "FBX", "undecided"]},
        "reimportNamingPolicy": {"type": "string"}
      }
    },
    "accuracyClaims": {"type": "object"},
    "openQuestions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}

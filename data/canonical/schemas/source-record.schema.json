{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPLB Source Provenance Record",
  "type": "object",
  "required": ["id", "provider", "sourceUrl", "accessedAt", "rightsStatus", "intendedUse"],
  "properties": {
    "id": {"type": "string", "pattern": "^source:"},
    "provider": {"type": "string", "minLength": 1},
    "sourceUrl": {"type": "string", "minLength": 1},
    "accessedAt": {"type": "string", "minLength": 1},
    "capturedAt": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]},
    "attribution": {"type": ["string", "null"]},
    "redistribution": {"type": ["string", "null"]},
    "rightsStatus": {"enum": ["open-redistributable", "open-attribution-required", "share-alike", "internal-reference-only", "permission-required", "restricted-do-not-ingest", "uncertain", "blocked"]},
    "contentHash": {"type": ["string", "null"]},
    "coverage": {"type": ["object", "null"]},
    "intendedUse": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPLB Central Wave Production Manifest",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "policy", "records"],
  "properties": {
    "schemaVersion": {"const": "uplb-central-wave-production-manifest-v0.1"},
    "generatedAt": {"type": "string"},
    "policy": {"type": "object"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["featureId", "sourceFeatureId", "identityStatus", "status", "objPath", "objSha256", "qaStatus", "triangleEquivalent"],
        "properties": {
          "featureId": {"type": "string", "pattern": "^uplb:"},
          "sourceFeatureId": {"type": "string", "pattern": "^(candidate:|uplb:)"},
          "identityStatus": {"enum": ["canonical", "reviewed-candidate", "proposed-candidate"]},
          "status": {"type": "string"},
          "objPath": {"type": "string"},
          "objSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "qaStatus": {"enum": ["pass", "fail"]},
          "triangleEquivalent": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
